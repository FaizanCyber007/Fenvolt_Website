# Canonical origin used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://fenvolt.com

# Contact form delivery (Resend — https://resend.com).
# 1. Create an API key: Resend dashboard → API Keys → Create.
# 2. Verify fenvolt.com under Domains and add the SPF / DKIM records it gives you.
# 3. Set CONTACT_FROM_EMAIL to an address on the verified domain.
#
# Every submission is sent to CONTACT_TO_EMAIL with the visitor's address as
# reply-to, so replying from the inbox answers them directly.
# If RESEND_API_KEY is missing the form does not pretend to send: it composes
# the message and offers a prefilled mailto instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@fenvolt.com
CONTACT_FROM_EMAIL=Fenvolt Website <hello@fenvolt.com>
