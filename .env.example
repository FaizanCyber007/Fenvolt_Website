# Canonical origin used for metadata, sitemap and Open Graph URLs.
# Confirm the production domain before launch.
NEXT_PUBLIC_SITE_URL=https://fenvolt.com

# Contact form delivery (Resend). The form degrades to a prefilled mailto
# when these are absent — it never pretends a message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Fenvolt <hello@your-verified-domain.com>
